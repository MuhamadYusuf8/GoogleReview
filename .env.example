# ─── Supabase Configuration ───────────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Short Domain & Production URL ─────────────────────────────────────────
# Domain pendek yang dicetak pada kartu fisik / NFC (tanpa https://)
# Contoh untuk Vercel: nama-project.vercel.app atau go.reviewku.id
NEXT_PUBLIC_SHORT_DOMAIN=your-app.vercel.app

# URL publik aplikasi web lengkap (termasuk https://)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
